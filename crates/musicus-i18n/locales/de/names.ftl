# Wörter abgeleiteter Stimmennamen (a-client-part-names). Instrumentnamen und
# Stimmnummern sind Daten des Ensembles und werden nie übersetzt.
# German draft, needs maintainer review.

# "Klarinette in B 1 & 2". Its literal words ("in") are ignored by the library search.
part-name-with-key = { $instruments } in { $key }
part-name-no-instrument = Stimme
part-name-unnamed = Unbenannte Stimme
part-name-instrument-sep = {" / "}
part-name-voice-sep = {" & "}

# German note names (agreed): B = B♭, Es = E♭, H = B♮.
key-name-Bb = B
key-name-Eb = Es
key-name-F = F
key-name-C = C
key-name-A = A
key-name-D = D
key-name-G = G
key-name-E = E
key-name-Ab = As
key-name-Db = Des
key-name-Gb = Ges
key-name-H = H
# Entry of the key selection: German musicians read "H".
key-option-H = H

annotations-set-default-name = Meine Anmerkungen
